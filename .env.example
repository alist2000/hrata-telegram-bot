# === Telegram Bot Configuration ===
TELEGRAM_BOT_TOKEN=your_bot_token_here

# The channel username (without @) or channel ID that users must join
# Example: "mychannel" or "-1001234567890"
REQUIRED_CHANNEL=your_channel_username_or_id

# === AI Provider Configuration ===
# Get your free API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# === Bot Settings ===
# Maximum questions per user per day
DAILY_QUESTION_LIMIT=5

# Maximum response length (tokens)
MAX_RESPONSE_TOKENS=500

# Bot language for system messages (en/fa)
BOT_LANGUAGE=en
